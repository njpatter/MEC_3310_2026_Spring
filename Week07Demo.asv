clear all; close all; clc

samplingFreq = 10000;

mlist = daqlist;
mId = mlist.DeviceID;
mDaq = daq('ni');
mDaq.Rate = samplingFreq;

ch = mDaq.addinput(mId, "ai0", "Voltage");
ch.Range = [-5 5];

[data, time] = mDaq.read(seconds(3), "OutputFormat","Matrix");
data =
L = length(data);
Y = fft(data);
P2 = abs(Y/L);
P1 = P2(1:L/2 + 1);
P1(2:end-1) = 2*P1(2:end-1);
f = samplingFreq / L * (0:(L/2));

plot(time, data)
figure 
plot(f, P1)